正常库存状态总数==(If(库存状态=正常))&VecDimCount($仓库管理:原料仓*原料列表),
偏低库存状态总数==(If(库存状态=偏低))&VecDimCount($仓库管理:原料仓*原料列表),
不足库存状态总数==(If(库存状态=不足))&VecDimCount($仓库管理:原料仓*原料列表)
}@(EditRead=Read,Type=Form,SubType=Block,TextSize=18)

$仓库管理:原料仓*原料列表:{
原料编号,原料名称,
原料类别=原料乳胶||原料丁腈||化学品||包装材料||其他,
规格,单位=kg||g||L||个||箱,
安全库存,当前库存,
库存状态=正常@(TextRGBA=(70,180,90,1))||偏低@(TextRGBA=(250,190,50,1))||不足@(TextRGBA=(220,60,60,1)),
供应商,
原料状态=启用||停用,
保质期=180||365
}
@(Type=Table,SubType=Block,FixColumn=原料编号,ReqItem=(原料编号,原料名称,原料类别,规格,单位,安全库存,当前库存,库存状态),MainParam=(原料编号)):[
