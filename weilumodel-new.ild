/* =============================  订单管理  =================================== */
$订单管理:订单管理*订单列表:{
订单编号,
客户名称,
产品编号==$基础数据:产品管理*产品列表:{产品编号},
产品名称==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{产品名称},
颜色==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{颜色},
尺码==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{尺码},
克重==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{克重},
长度==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{长度},
拉力==(Type=Auto,(If(产品编号=*订单列表:产品编号)))$基础数据:产品管理*产品列表:{拉力},
优先级=普通@(TextRGBA=(50,120,220,1),TextBackRGBA=(240,245,252,1))||急单@(TextRGBA=(220,60,60,1),TextBackRGBA=(248,240,240,1))||返工@(TextRGBA=(250,190,50,1),TextBackRGBA=(255,247,239,1)),
纸盒信息,纸箱信息,纸盒数量,纸箱数量,
产品数量,
交货日期@(Type=Date),
拆分产线/*==(Type=Auto)&算法库:生产算法:自动排产({订单编号,产品数量,交货日期})*/,
订单状态=待审核@(TextRGBA=(250,190,50,0.6))||已排产@(TextRGBA=(70,180,90,1),TextBackRGBA=(235,245,238,1))||生产中@(TextRGBA=(50,120,220,1),TextBackRGBA=(240,245,252,1))||
待排产@(TextRGBA=(250,190,50,1))||已完结@(TextRGBA=(70,180,90,1),TextBackRGBA=(235,245,238,1))||已取消@(TextRGBA=(220,60,60,1),TextBackRGBA=(248,240,240,1))
}
@(Type=Table,SubType=Block,FixColumn=订单编号,ReqItem=(订单编号,客户名称,产品编号,优先级,产品数量,交货日期,拆分产线,订单状态),MainParam=(订单编号)):[
