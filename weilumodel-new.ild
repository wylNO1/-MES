/*包材仓*/
$仓库管理:包材仓*包材仓:包材库存统计:{
纸盒类型总数==(If(纸盒信息=3层纸盒))&VecDimCount($仓库管理:包材仓*包材列表),
纸箱类型总数==(If(纸箱信息=5层纸箱))&VecDimCount($仓库管理:包材仓*包材列表)
}@(EditRead=Read,Type=Form,SubType=Block,TextSize=18)

$仓库管理:包材仓*包材列表:{
纸盒信息,纸箱信息,纸盒数量,纸箱数量
}
@(Type=Table,SubType=Block,ReqItem=(纸盒信息,纸箱信息,纸盒数量,纸箱数量)):[
[3层纸盒,5层纸箱,1200,120]]

/*成品仓*/
$仓库管理:成品仓*成品仓:成品库存统计:{
成品总数==&VecDimCount($仓库管理:成品仓*成品列表),
正常成品数量==(If(成品状态=正常))&VecDimCount($仓库管理:成品仓*成品列表),
不足成品数量==(If(成品状态=不足))&VecDimCount($仓库管理:成品仓*成品列表)，
偏低成品数量==(If(成品状态=偏低))&VecDimCount($仓库管理:成品仓*成品列表)
}@(EditRead=Read,Type=Form,SubType=Block,TextSize=18)

$仓库管理:成品仓*成品列表:{
成品编号,成品名称,成品类别,成品库存,
成品状态=正常@(TextRGBA=(70,180,90,1))||偏低@(TextRGBA=(250,190,50,1))||不足@(TextRGBA=(220,60,60,1))
}
@(Type=Table,SubType=Block,FixColumn=成品编号,ReqItem=(成品编号,成品名称,成品类别,成品库存),MainParam=(成品编号)):[
